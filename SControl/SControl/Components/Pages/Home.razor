@page "/"
<PageTitle>Home</PageTitle>

<MudLayout>
    <MudAppBar Elevation="4">
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="text-center">S Control</MudText>
        <MudSpacer />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4" Style="padding-top: 20px;">
            <MudGrid>
                <MudItem xs="12" class="text-center mb-4">
                    <MudText Typo="Typo.h4" GutterBottom="true" Class="text-primary font-weight-bold">Welcome to S Control</MudText>
                    <MudText Class="mb-4 text-muted" Typo="Typo.body1">An advanced and efficient solution designed to manipulate and transform paragraphs of text with unparalleled precision and ease.</MudText>
                </MudItem>

                <MudItem xs="12" class="mb-4">
                    <MudTextField @bind-Value="userInput" Label="Enter your paragraph here" Lines="6" Variant="Variant.Filled" Margin="Margin.Dense" FullWidth="true" />
                </MudItem>

                <!-- Action Buttons Section - All buttons in one row -->
                <MudItem xs="12" class="mb-3">
                    <MudStack Direction="Row" Spacing="2" Justify="Justify.Center">
                        <MudButton Class="custom-button" OnClick="TransformToUpperCase">Uppercase</MudButton>
                        <MudButton Class="custom-button" OnClick="ReverseText">Reverse</MudButton>
                        <MudButton Class="custom-button" OnClick="ShortenText">Shorten</MudButton>
                        <MudButton Class="custom-button" OnClick="AnalyzeSentiment">Sentiment</MudButton>
                    </MudStack>
                </MudItem>

                <MudItem xs="12" class="mt-4">
                    <MudText Typo="Typo.h5" GutterBottom="true" Class="text-accent">Result:</MudText>
                    <MudText Typo="Typo.body2">@result</MudText>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
    /* Button Styles */
    .custom-button {
        width: 160px;
        height: 48px;
        font-weight: bold;
        text-transform: uppercase;
        border-radius: 8px; /* Rectangle shape */
        background-color: #607d8b; /* Slate gray color */
        color: white;
        border: none;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

    /* Button Hover Effect */
    .custom-button:hover {
        background-color: #455a64; /* Darker slate gray */
    }

    /* Button Active State */
    .custom-button:active {
        box-shadow: none;
        opacity: 0.9;
    }
</style>

@code {
    private string userInput = string.Empty;
    private string result = string.Empty;

    private void TransformToUpperCase()
    {
        result = userInput.ToUpper();
    }

    private void ReverseText()
    {
        result = new string(userInput.Reverse().ToArray());
    }

    private void ShortenText()
    {
        result = userInput.Length > 50 ? userInput.Substring(0, 50) + "..." : userInput;
    }

    private void AnalyzeSentiment()
    {
        if (userInput.Contains("happy") || userInput.Contains("HAPPY") || userInput.Contains("joy") || userInput.Contains("JOY") || userInput.Contains("good") || userInput.Contains("GOOD"))
        {
            result = "The sentiment seems POSITIVE!";
        }
        else if (userInput.Contains("sad") || userInput.Contains("SAD") || userInput.Contains("angry") || userInput.Contains("ANGRY") || userInput.Contains("bad") || userInput.Contains("BAD") )
        {
            result = "The sentiment seems NEGATIVE!";
        }
        else
        {
            result = "The sentiment is NEUTRAL.";
        }
    }
}
